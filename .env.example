# Base URL of the Weblate instance (no trailing slash)
WFB_WEBLATE_URL=http://192.168.56.220:2080
# OPTIONAL API token (Weblate profile -> Settings -> API keys).
# If omitted, the app runs in session mode: users sign in through the
# login view with their Weblate account; their session is held
# server-side per browser session.
WFB_WEBLATE_API_KEY=
# Whether the instance has the review workflow ("Enable reviews") turned on.
# Controls the "not approved" part of the needs-review filter.
WFB_WEBLATE_REVIEW_WORKFLOW=true
# Set to "true" to force the built-in mock Weblate (no network needed).
WFB_MOCK_WEBLATE=false
# Ports
WFB_PORT=4000
# Public (key-less) REST export. Both variables must be set to allow
# export requests without an API key from the allowed client hosts.
# The key must be a valid Weblate API key; the hosts are comma-separated
# CIDR ranges (e.g. 192.168.56.0/24,::1). A bare IP matches that single
# address only — allow any host with 0.0.0.0/0,::/0 (IPv6 clients,
e.g. ::1 from "localhost", need ::/0 too).
WFB_WEBLATE_EXPORT_API_KEY=
WFB_WEBLATE_EXPORT_ALLOWED_HOSTS=
# Opt-in Swagger UI for the REST API at /openapi/ (docs page + spec at
# /api/rest/v1/openapi.json). Values are case- and blank-insensitive:
# true / on / 1 enable read-only docs; try / with-try / with_try /
# swagger-with-try / swagger_with_try also enable the "Try it out" button.
# Anything else (or unset) disables it.
WFB_OPENAPI=
# Docker compose only (docker compose reads this file for interpolation;
# the app itself ignores it). Name of the deployed container; defaults to
# weblate-friendly-bridge. Leave commented unless you need another name.
#WFB_CONTAINER_NAME=weblate-friendly-bridge
# Docker compose only: host-side port binding of the container — a port
# ("8080" binds 0.0.0.0:8080) or an "ip:port" binding ("127.0.0.1:8080").
# Defaults to 4000. Leave commented unless you need another binding.
#WFB_CONTAINER_PORT=4000
